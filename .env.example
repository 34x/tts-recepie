# TTS Project Configuration
# This file is used as a fallback for defaults. 
# Copy to .env to override these values.

# Root directory for all model weights and caches.
# All backends will store their data in subfolders here.
TTS_MODELS_ROOT=~/.cache/tts-models

# Client-side chunking for streamed playback. The server publishes these in
# /config; the UI chunker uses them instead of its built-in defaults
# (200 target / 1000 hard cap). Target = preferred chunk size in chars,
# hard = max size for a single pathological sentence.
#TTS_CHUNK_CHARS=200
#TTS_CHUNK_HARD=1000

# Optional: override specific paths if you have them elsewhere
# MODELS_DIR=~/.cache/tts-models/models
# PIPER_VOICES_DIR=~/.cache/tts-models/piper
# REFS_DIR=~/.cache/tts-models/refs
