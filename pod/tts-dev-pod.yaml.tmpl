    # ── UI (not a backend; TTS_BACKENDS injected by start_pod.py) ────────────
    - name: ui
      image: localhost/tts-ui:dev
      ports:
        - containerPort: 8099
          hostPort: 18100
      env:
        - name: PORT
          value: "8099"
        # TTS_BACKENDS is injected by start_pod.py from the backend labels/ports.
        - name: TTS_BACKENDS
          value: "[]"
      command: ["python3", "-u", "server.py"]
      volumeMounts:
        - name: tts-ui-code
          mountPath: /app

