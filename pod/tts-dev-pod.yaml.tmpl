# TTS dev stack — single pod, all backends + UI share one network namespace.
# This is a TEMPLATE. Variables like ${TTS_APP_DIR} are replaced by start_pod.py
# using values from .env.
#
# Each backend container is tagged with `tts.backend: "true"` and a DISTINCT
# containerPort (they share the pod netns, so no two may bind the same port).
# The helper `start_pod.py` parses this file, auto-detects the backends, builds
# the TTS_BACKENDS JSON for the UI, and pipes the manifest to `podman kube play -`.
#
# Adding a backend = add one container block here (distinct port + the label).
# The UI wiring is automatic — no hand-editing the UI config.
#
# Host ports (outside the pod range 8094-8099): 18095-18099 backends, 18100 UI.
apiVersion: v1
kind: Pod
metadata:
  name: tts-dev
  labels:
    app: tts-dev
spec:
  # ROCm/HSA needs host IPC for shared-memory allocation (AGENTS.md: --ipc=host ALWAYS).
  hostIPC: true
  containers:
    # ── Backends (tagged tts.backend: "true") ──────────────────────────────
    - name: piper
      image: localhost/piper-tts:latest
      labels:
        tts.backend: "true"
      ports:
        - containerPort: 8095
          hostPort: 18095
      env:
        - name: HOST
          value: "0.0.0.0"
        - name: PORT
          value: "8095"
        - name: PIPER_VOICES_DIR
          value: /piper/voices
      command: ["/bin/sh", "-c"]
      args:
        - "pip install -q soundfile && python /app/piper_tts.py"
      volumeMounts:
        - name: piper-voices
          mountPath: /piper/voices
        - name: piper-code
          mountPath: /app/piper_tts.py
          subPath: piper_tts.py
        - name: backbone-code
          mountPath: /app/openai_tts_server.py
          subPath: openai_tts_server.py

    - name: supertonic
      image: localhost/supertonic-tts:latest
      labels:
        tts.backend: "true"
      ports:
        - containerPort: 8096
          hostPort: 18099
      env:
        - name: HOST
          value: "0.0.0.0"
        - name: PORT
          value: "8096"
        - name: SUPERTONIC_STEPS
          value: "12"
      command: ["python", "/app/supertonic_tts.py"]
      volumeMounts:
        - name: supertonic-code
          mountPath: /app/supertonic_tts.py
          subPath: supertonic_tts.py
        - name: backbone-code
          mountPath: /app/openai_tts_server.py
          subPath: openai_tts_server.py
        - name: supertonic-model-cache
          mountPath: /root/.cache/supertonic3

    - name: cutetts
      image: localhost/tts-cutetts:latest
      labels:
        tts.backend: "true"
      ports:
        - containerPort: 8097
          hostPort: 18098
      env:
        - name: HOST
          value: "0.0.0.0"
        - name: PORT
          value: "8097"
        - name: CUTETTS_MODEL_DIR
          value: /models/CuteTTS
        - name: CUTETTS_DEVICE
          value: cpu
      command: ["python", "cutetts_tts.py"]
      volumeMounts:
        - name: cutetts-weights
          mountPath: /models/CuteTTS

    - name: kokoro
      image: localhost/tts-kokoro:latest
      labels:
        tts.backend: "true"
      ports:
        - containerPort: 8098
          hostPort: 18097
      env:
        - name: HOST
          value: "0.0.0.0"
        - name: PORT
          value: "8098"
        - name: KOKORO_MODEL_PATH
          value: /models/kokoro/kokoro-v1.0.int8.onnx
        - name: KOKORO_VOICES_PATH
          value: /models/kokoro/voices-v1.0.bin
        - name: OMP_NUM_THREADS
          value: "16"
      command: ["python", "kokoro_tts.py"]
      volumeMounts:
        - name: kokoro-weights
          mountPath: /models/kokoro

