# Audio8 TTS 0.6B ONNX INT4 — CPU container (option 1: built-in server)
# Uses the newer arktts_runtime from GitHub master (supports semantic_then_eos
# logits layout, which the 0.6B manifest declares; the 0.1B runtime does not).
# Model weights are bind-mounted read-only at /model; voices at /voices.
FROM python:3.12-slim

WORKDIR /app

# Copy the master ONNX runtime (arktts_runtime package + requirements)
COPY onnx_runtime_0_6b_int4/arktts_runtime/ /app/arktts_runtime/
COPY onnx_runtime_0_6b_int4/scripts/ /app/scripts/
COPY onnx_runtime_0_6b_int4/requirements.txt /app/requirements.txt

RUN pip install --no-cache-dir -r /app/requirements.txt

# Model + voices are bind-mounted at runtime
ENV ARKTTS_MODEL_DIR=/model \
    ARKTTS_VOICES_DIR=/voices \
    ARKTTS_REGISTRATION_DIR=/model/registration \
    ARKTTS_PRECISION=int4 \
    ARKTTS_CODEC_PRECISION=fp16 \
    ARKTTS_THREADS=5 \
    HOST=0.0.0.0 \
    PORT=8025

EXPOSE 8025

CMD ["python", "-m", "uvicorn", "arktts_runtime.service:app", "--app-dir", "/app", "--host", "0.0.0.0", "--port", "8025"]
